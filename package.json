{
  "name": "badminton-matchmaking",
  "version": "1.0.0",
  "description": "Badminton session matchmaking with Fair/Champion modes and emergency host controls",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "sim": "node sim/cli.js",
    "sim:quick": "node sim/cli.js --quick",
    "sim:tune": "node sim/tune.js && node sim/tune.js --round2"
  }
}
